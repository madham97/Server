# Copy to .env and fill in. docker compose reads .env automatically.
# .env is gitignored; this example file is not — keep real secrets out of it.

# Shared secret required by POST /upload. Generate with:
#   echo "UPLOAD_TOKEN=$(openssl rand -hex 24)" >> .env
# The Pi must carry the same value as "upload_token" in its config/client.json.
# Leave unset only while the server has no route from the internet: an empty token
# means /upload accepts writes from anyone who can reach it.
UPLOAD_TOKEN=
