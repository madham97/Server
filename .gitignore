# Local secrets — UPLOAD_TOKEN and anything else docker compose reads.
# Never commit; see .env.example for the shape.
.env
*.env
!.env.example

uploads/
processed/
failed/
thermal/
calibration/*
!calibration/profiles.json
dataset/
annotated/
runs/
models/runs/
models/archive/
models/candidate.pt
models/best.pt
__pycache__/
*.pt
upload_log.txt
processed_log.txt
annotation_log.txt
# Published client update bundles. Build artifacts, not source: a new ~68KB tarball is written
# on every publish, and each would live in history forever. Provenance is already exact without
# them — Rodent-client commit 8b5822b matches 20260824T074110Z.tgz byte for byte, verified at
# publish time — so the source repo is the record of what shipped, not this directory.
client_updates/*.tgz
client_updates_archive/
