[Unit]
Description=ngrok tunnel (plain HTTP, for the Pi uploader)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Server
ExecStart=%h/Server/ngrok http --scheme http 8000
Restart=always
RestartSec=5
StandardOutput=append:%h/ngrok.log
StandardError=append:%h/ngrok.log

[Install]
WantedBy=default.target
